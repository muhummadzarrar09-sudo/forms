# Never commit a real .env file. Configure these in Vercel or a local ignored .env.
# Use credentials from the active production/staging Supabase project.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require"
NEXTAUTH_URL="https://your-production-domain.example"
NEXTAUTH_SECRET="generate-with-openssl-rand-hex-32"

# Optional public URL used for canonical/metadata URLs when not on Vercel.
NEXT_PUBLIC_APP_URL="https://your-production-domain.example"
