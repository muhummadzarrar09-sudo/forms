# Copy to .env.local for local development, or configure these in your hosting
# provider. Never commit real credentials or use a production project for tests.

# --- Supabase project ---
# Safe to expose to the browser: RLS protects these publishable values.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-anon-key"

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never commit it. The Next API
# verifies the caller with Supabase Auth before using this RLS-bypassing client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# One-time existing-account forced-reset cutover helper only.
SUPABASE_AUTH_REDIRECT_TO="https://forms.example.com/reset-password"

# --- Email/cron/integration server secrets ---
# Supabase Auth sends verification/recovery email. SMTP variables are retained
# only until the legacy NextAuth mail code is removed during cutover.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
CRON_SECRET="generate-a-long-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
INTEGRATION_ENCRYPTION_KEY="base64-32-byte-key"

# Only set when a trusted edge overwrites X-Real-IP; otherwise backend rate
# limits must use a platform-provided trusted identity strategy.
TRUST_PROXY_HEADERS="true"
