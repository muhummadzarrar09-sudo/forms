generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  emailVerified DateTime?
  password  String
  name      String   @default("")
  // Incremented on credential resets to invalidate previously issued JWTs.
  sessionVersion Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  forms     Form[]
  workspaces Workspace[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  googleConnection GoogleConnection?
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model GoogleConnection {
  id                   String   @id @default(cuid())
  userId               String   @unique
  encryptedRefreshToken String
  encryptedAccessToken String?
  accessTokenExpiresAt DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinations         GoogleSheetDestination[]
}

model GoogleSheetDestination {
  id             String   @id @default(cuid())
  formId         String   @unique
  connectionId   String
  spreadsheetId  String
  sheetName      String
  active         Boolean  @default(true)
  lastSyncedAt   DateTime?
  lastError      String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  form           Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  connection     GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  events         GoogleSheetSyncEvent[]

  @@index([connectionId])
}

model GoogleSheetSyncEvent {
  id            String   @id @default(cuid())
  destinationId String
  responseId    String
  status        String   @default("pending")
  attempts      Int      @default(0)
  lastError     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  destination   GoogleSheetDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  response      Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([destinationId, responseId])
  @@index([status, updatedAt])
}

model Form {
  id          String     @id @default(cuid())
  title       String     @default("Untitled Form")
  description String     @default("")
  slug        String?    @unique // URL-friendly identifier for sharing
  published   Boolean    @default(false)
  welcomeTitle String    @default("Welcome!")
  welcomeMessage String  @default("Thanks for taking the time to fill this out.")
  endingTitle String     @default("Thank you!")
  endingMessage String   @default("Your response has been recorded.")
  theme       String     @default("default") // default, dark, warm, cool, nature
  backgroundColor String @default("#FFFFFF")
  textColor   String     @default("#333333")
  buttonColor String     @default("#1A1A1A")
  buttonTextColor String @default("#FFFFFF")
  fontFamily  String     @default("sans")
  logoUrl     String?
  coverUrl    String?
  progressbar Boolean    @default(true)
  showQuestionNumbers Boolean @default(true)
  allowBackNavigation Boolean @default(true)
  favorite    Boolean    @default(false)
  archived    Boolean    @default(false)
  tags        String     @default("[]") // JSON array of tag strings
  hiddenFields String    @default("[]") // JSON array of hidden field definitions
  calculatedVariables String @default("[]") // JSON array of named safe arithmetic formulas
  maxResponses Int       @default(0) // 0 = unlimited
  closeDate   DateTime?  // auto-close date, null = no auto-close
  metaTitle   String     @default("") // SEO meta title
  metaDescription String @default("") // SEO meta description
  userId      String
  workspaceId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  questions   Question[]
  responses   Response[]
  endings     FormEnding[]
  googleSheetDestination GoogleSheetDestination?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([workspaceId])
}

model Workspace {
  id          String     @id @default(cuid())
  name        String
  color       String     @default("#6366f1")
  icon        String     @default("Folder")
  order       Int        @default(0)
  userId      String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  forms       Form[]
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, order])
}

model Question {
  id          String   @id @default(cuid())
  formId      String
  type        String   // short_text, long_text, multiple_choice, dropdown, email, number, rating, opinion_scale, yes_no, date, picture_choice, phone, website, legal, statement, ending
  title       String
  description String   @default("")
  required    Boolean  @default(false)
  order       Int      @default(0)
  options     String   @default("[]") // JSON array of option strings
  imageUrls   String   @default("[]") // JSON array of image URLs for picture_choice
  settings    String   @default("{}") // JSON object for type-specific settings (e.g., min/max for number, steps for rating, etc.)
  logic       String   @default("[]") // JSON array of logic rules for conditional jumps
  placeholder String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers     Answer[]

  @@index([formId, order])
}

model Response {
  id          String   @id @default(cuid())
  formId      String
  startedAt   DateTime @default(now())
  completedAt DateTime?
  isPartial   Boolean  @default(false) // true = abandoned/in-progress
  score       Int      @default(0) // total score if scoring is enabled
  status      String   @default("new") // new, reviewing, qualified, follow_up, closed
  internalNote String  @default("")
  metadata    String   @default("{}") // JSON: userAgent, ip, referer, etc.
  // SHA-256 verifier for the anonymous draft-resume bearer credential. The
  // original credential is returned once and is never persisted in plaintext.
  editTokenHash      String?   @unique
  editTokenExpiresAt DateTime?
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers     Answer[]
  googleSheetSyncEvents GoogleSheetSyncEvent[]

  @@index([formId, startedAt])
  @@index([formId, isPartial])
}

model Answer {
  id         String   @id @default(cuid())
  responseId String
  questionId String
  value      String   @default("") // The answer value (stringified for flexibility)
  score      Int      @default(0) // score awarded for this answer
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([questionId])
}

model FormEnding {
  id          String   @id @default(cuid())
  formId      String
  title       String   @default("Thank you!")
  message     String   @default("Your response has been recorded.")
  redirectUrl String?
  showScore   Boolean  @default(false) // show calculated score on ending screen
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, order])
}


/// Durable, cluster-wide fixed-window counter for unauthenticated endpoints.
/// `key` is a SHA-256 digest, never a raw IP address.
model PublicRateLimit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt
}
